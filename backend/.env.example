# PostgreSQL local (docker compose). Para SQLite en desarrollo: sqlite:///./foodstore.db
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/foodstore_db

# Firma del JWT: mínimo 32 caracteres.
# Generá la tuya con: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=47ffb5da0aca9ce34e6b25a838fc06eb0c82faa08948c0b080360b509b7dffd4
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Origen del frontend permitido por CORS (sin barra final)
FRONTEND_ORIGIN=http://localhost:5173